# Where the FastAPI backend is running. In production this is the deployed API
# origin; the backend's FRONTEND_ORIGIN must name this app in return, or CORS
# rejects every request.
VITE_API_URL=http://localhost:8000

# Currency for display. Stripe test mode charges USD - Stripe does not operate
# in Ghana, which is why the production note names Paystack. Changing this
# changes labels only; it does not change what Stripe charges.
VITE_CURRENCY=USD
